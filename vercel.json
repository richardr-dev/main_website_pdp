{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/services/uu-pdp-workspace",
      "destination": "/services/managed-data-protection",
      "permanent": true
    },
    {
      "source": "/services/uu-pdp",
      "destination": "/services/uu-pdp-readiness-assessment",
      "permanent": true
    },
    {
      "source": "/services/uu-pdp-compliance",
      "destination": "/services/uu-pdp-readiness-assessment",
      "permanent": true
    },
    {
      "source": "/services/backup-restore",
      "destination": "/services/managed-backup-recovery",
      "permanent": true
    },
    {
      "source": "/services/data-recovery",
      "destination": "/services/managed-backup-recovery",
      "permanent": true
    },
    {
      "source": "/services/colocation-server",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/managed-infrastructure",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/cloud-aws",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/patuhdata-academy",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/insights/managed-it",
      "destination": "/insights",
      "permanent": true
    },
    {
      "source": "/layanan/pdp-readiness-assessment",
      "destination": "/services/uu-pdp-readiness-assessment",
      "permanent": true
    },
    {
      "source": "/layanan/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/template-gratis",
      "destination": "/#resources",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
