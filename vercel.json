      "permanent": true
    },
    {
      "source": "/services/disaster-recovery",
      "destination": "/services/managed-it-business-continuity",
      "permanent": true
    },
    {
      "source": "/services/business-continuity",
      "destination": "/services/managed-it-business-continuity",
      "permanent": true
    },
    {
      "source": "/services/business-continuity-planning",
      "destination": "/services/managed-it-business-continuity",
      "permanent": true
    },
    {
      "source": "/services/backup-restore",
      "destination": "/services/managed-it-business-continuity",
      "permanent": true
    },
    {
      "source": "/services/data-recovery",
      "destination": "/services/managed-it-business-continuity",
      "permanent": true
    },
    {
      "source": "/services/uu-pdp",
      "destination": "/services/managed-it-business-continuity",
      "permanent": true
    },
    {
      "source": "/services/uu-pdp-compliance",
      "destination": "/services/managed-it-business-continuity",
      "permanent": true
    },
    {
      "source": "/services/uu-pdp-setup-sprint",
      "destination": "/services/managed-it-business-continuity",
      "permanent": true
    },
    {
      "source": "/services/uu-pdp-readiness-assessment",
      "destination": "/services/managed-it-business-continuity",
      "permanent": true
    },
    {
      "source": "/services/uu-pdp-workspace",
      "destination": "/services/managed-it-business-continuity",
      "permanent": true
    },
    {
      "source": "/services/managed-data-protection",
      "destination": "/services/managed-it-business-continuity",
      "permanent": true
    },
    {
      "source": "/services/migration-services",
      "destination": "/services/it-infrastructure-implementation",
      "permanent": true
    },
    {
      "source": "/services/managed-cloud-infrastructure",
      "destination": "/services/it-infrastructure-implementation",
      "permanent": true
    },
    {
      "source": "/services/managed-infrastructure",
      "destination": "/services/it-infrastructure-implementation",
      "permanent": true
    },
    {
      "source": "/services/cloud-aws",
      "destination": "/services/it-infrastructure-implementation",
      "permanent": true
    },
    {
      "source": "/services/migration",
      "destination": "/services/it-infrastructure-implementation",
      "permanent": true
    },
    {
      "source": "/services/cloud-migration",
      "destination": "/services/it-infrastructure-implementation",
      "permanent": true
    },
    {
      "source": "/services/colocation-server",
      "destination": "/services/it-infrastructure-implementation",
      "permanent": true
    },
    {
      "source": "/services/custom-software-development",
      "destination": "/services/business-systems-integration",
      "permanent": true
    },
    {
      "source": "/services/systems-integration",
      "destination": "/services/business-systems-integration",
      "permanent": true
    },
    {
      "source": "/services/production-operations-systems",
      "destination": "/services/business-systems-integration",
      "permanent": true
    },
    {
      "source": "/services/privacy-technology-remediation",
      "destination": "/services/business-systems-integration",
      "permanent": true
    },
    {
      "source": "/services/patuhdata-academy",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/work/:path*",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/insights",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/insights/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/downloads/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/template-gratis",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/layanan/:path*",
      "destination": "/id",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
